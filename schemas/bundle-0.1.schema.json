                "status",
                "severity",
                "evidence",
                "remediation"
              ],
              "properties": {
                "check_id": {
                  "enum": [
                    "PUB-001",
                    "PUB-002",
                    "PUB-003",
                    "PUB-004",
                    "PUB-005"
                  ]
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "const": "fail"
                },
                "severity": {
                  "enum": [
                    "medium",
                    "high",
                    "critical"
                  ]
                },
                "evidence": {
                  "type": "object",
                  "required": [
                    "line",
                    "redacted"
                  ],
                  "properties": {
                    "line": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "redacted": {
                      "const": true
                    }
                  },
                  "additionalProperties": false
                },
                "remediation": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false,
              "oneOf": [
                {
                  "properties": {
                    "check_id": {
                      "const": "PUB-001"
                    },
                    "severity": {
                      "const": "high"
                    },
                    "remediation": {
                      "const": "Replace internal addresses with documentation addresses."
                    }
                  }
                },
                {
                  "properties": {
                    "check_id": {
                      "const": "PUB-002"
                    },
                    "severity": {
                      "const": "medium"
                    },
                    "remediation": {
                      "const": "Replace internal domain names with example.invalid."
                    }
                  }
                },
                {
                  "properties": {
                    "check_id": {
                      "const": "PUB-003"
                    },
                    "severity": {
                      "const": "medium"
                    },
                    "remediation": {
                      "const": "Replace identifying user paths with synthetic examples."
                    }
                  }
                },
                {
                  "properties": {
                    "check_id": {
                      "const": "PUB-004"
                    },
                    "severity": {
                      "const": "critical"
                    },
                    "remediation": {
                      "const": "Remove the private key; if exposed, rotate it."
                    }
                  }
                },
                {
                  "properties": {
                    "check_id": {
                      "const": "PUB-005"
                    },
                    "severity": {
                      "const": "high"
                    },
                    "remediation": {
                      "const": "Review and replace the organization marker."
