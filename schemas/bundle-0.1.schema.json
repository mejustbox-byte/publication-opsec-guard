                  ],
                  "properties": {
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_files": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_total_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_findings": {
                      "type": "integer",
