                        "total_bytes_limit",
                        "finding_count_limit"
                      ]
                    },
                    "asset_id": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "status",
                    "reason"
                  ],
                  "properties": {
                    "status": {
                      "const": "not_tested"
                    },
                    "reason": {
                      "enum": [
                        "directory_unreadable",
                        "file_count_limit",
                        "directory_count_limit",
                        "empty_scope"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
