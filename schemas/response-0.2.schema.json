{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication OPSEC Guard response contract 0.2",
  "description": "Structural contract. Cross-field invariants are checked by validate_report.py.",
  "oneOf": [
    {
      "$ref": "#/$defs/report"
    },
    {
      "$ref": "#/$defs/startup_error"
    }
  ],
  "$defs": {
    "report": {
      "type": "object",
      "required": [
        "schema_version",
        "tool_version",
        "scope",
        "coverage_complete",
        "files_inspected",
        "files_encountered",
        "bytes_read",
        "scan_stopped",
        "limits",
        "exclusions",
        "findings",
        "coverage_gaps"
      ],
      "properties": {
        "schema_version": {
          "const": "0.2"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "utf8-text-only"
        },
        "coverage_complete": {
          "type": "boolean"
        },
        "files_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "files_encountered": {
          "type": "integer",
          "minimum": 0
        },
        "bytes_read": {
          "type": "integer",
          "minimum": 0
        },
        "scan_stopped": {
          "type": "boolean"
        },
        "limits": {
          "type": "object",
          "required": [
            "max_bytes",
            "max_files",
            "max_total_bytes",
            "max_findings",
            "max_directories"
          ],
          "properties": {
            "max_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_files": {
              "type": "integer",
              "minimum": 1
            },
            "max_total_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "max_findings": {
              "type": "integer",
              "minimum": 1
            },
            "max_directories": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      },
      "additionalProperties": false
    },
    "startup_error": {
      "type": "object",
      "required": [
        "error",
        "status"
      ],
      "properties": {
        "error": {
          "const": "Invalid input or policy"
        },
        "status": {
          "const": "not_tested"
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "check_id",
        "asset_id",
        "status",
        "severity",
        "evidence",
        "remediation"
      ],
      "properties": {
        "check_id": {
          "enum": [
            "PUB-001",
            "PUB-002",
            "PUB-003",
            "PUB-004",
            "PUB-005"
          ]
        },
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "fail"
        },
        "severity": {
          "enum": [
            "medium",
            "high",
            "critical"
          ]
        },
        "evidence": {
          "type": "object",
          "required": [
            "line",
            "redacted"
          ],
          "properties": {
            "line": {
              "type": "integer",
              "minimum": 1
            },
            "redacted": {
              "const": true
            }
          },
          "additionalProperties": false
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "check_id": {
              "const": "PUB-001"
            },
            "severity": {
              "const": "high"
            },
            "remediation": {
              "const": "Replace internal addresses with documentation addresses."
            }
          }
        },
        {
          "properties": {
            "check_id": {
              "const": "PUB-002"
            },
            "severity": {
              "const": "medium"
            },
            "remediation": {
              "const": "Replace internal domain names with example.invalid."
            }
          }
        },
        {
          "properties": {
            "check_id": {
              "const": "PUB-003"
            },
            "severity": {
              "const": "medium"
            },
            "remediation": {
              "const": "Replace identifying user paths with synthetic examples."
            }
          }
        },
        {
          "properties": {
            "check_id": {
              "const": "PUB-004"
            },
            "severity": {
              "const": "critical"
            },
            "remediation": {
              "const": "Remove the private key; if exposed, rotate it."
            }
          }
        },
        {
          "properties": {
            "check_id": {
              "const": "PUB-005"
            },
            "severity": {
              "const": "high"
            },
            "remediation": {
              "const": "Review and replace the organization marker."
            }
          }
        }
      ]
    },
    "gap": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "reason",
            "asset_id"
          ],
          "properties": {
            "status": {
              "const": "not_tested"
            },
            "reason": {
              "enum": [
                "unsupported_format",
                "symlink",
                "size_limit",
                "binary_content",
                "not_regular_file",
                "unreadable_or_invalid_utf8",
                "total_bytes_limit",
                "finding_count_limit"
              ]
            },
            "asset_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not_tested"
            },
            "reason": {
              "enum": [
                "directory_unreadable",
                "file_count_limit",
                "directory_count_limit",
                "empty_scope"
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "required": [
        "asset_id",
        "reason"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "const": "excluded_directory"
        }
      },
      "additionalProperties": false
    }
  }
}
